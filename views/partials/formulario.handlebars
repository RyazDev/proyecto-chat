<form class="composer" id="chat-form" method="post" aria-label="Enviar un mensaje" aria-describedby="send-help">
  <div class="composer-tools">
    <div class="name-field">
      <label class="sr-only" for="username">Nombre de usuario</label>
      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <circle cx="10" cy="6" r="3"/>
        <path d="M4 17v-1a6 6 0 0 1 12 0v1" stroke-linecap="round"/>
      </svg>
      <input id="username" name="username" type="text" placeholder="Tu nombre" autocomplete="nickname" maxlength="40" required>
    </div>
    <details class="advertisement-options" id="advertisement-options">
      <summary>Publicidad <span class="sr-only">opcional</span></summary>
      <div class="advertisement-field">
        <label class="sr-only" for="advertisement">Publicidad</label>
        <input id="advertisement" name="advertisement" type="text" placeholder="Escribe tu anuncio (opcional)" maxlength="240" aria-describedby="advertisement-help">
        <p class="sr-only" id="advertisement-help">Hasta 240 caracteres. Se adjunta al mensaje; el banner todavía no se actualiza.</p>
      </div>
    </details>
  </div>
  <p class="form-error" id="form-error" role="alert" hidden></p>
  <div class="composer-row">
    <label class="sr-only" for="message">Mensaje</label>
    <textarea id="message" name="message" rows="2" placeholder="Escribe un mensaje…" maxlength="1000" required aria-describedby="message-help"></textarea>
    <p class="sr-only" id="message-help">Hasta 1.000 caracteres. El nombre y el mensaje son obligatorios.</p>
    <button class="send-button" id="send-button" type="submit" disabled aria-describedby="send-help">
      <span id="send-label">Enviar</span>
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <path d="m21 3-7 18-4-7-7-4 18-7Z" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="m10 14 5-5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <p class="sr-only" id="send-help" role="status">Comprobando la conexión para enviar tu mensaje.</p>
</form>
