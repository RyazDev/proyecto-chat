<main class="app-shell" id="contenido">
  <section class="chat-card" aria-labelledby="chat-title">
    <header class="chat-header">
      <div class="chat-heading">
        <span class="chat-symbol" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M20 11a8 8 0 0 1-8 8H8l-5 3v-7a8 8 0 1 1 17-4Z" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8 9h8M8 13h5" stroke-linecap="round"/>
          </svg>
        </span>
        <h1 id="chat-title">Chat compartido</h1>
      </div>
      <span class="connection-state" id="connection-status" data-state="connecting" role="status" aria-live="polite" aria-atomic="true">
        <span class="status-dot" aria-hidden="true"></span>
        <span id="connection-label">Conectando…</span>
      </span>
    </header>
    <section class="advertising-banner" id="advertising-banner" aria-labelledby="advertising-title" aria-live="polite" aria-atomic="true">
      <h2 id="advertising-title">PUBLICIDAD</h2>
      <p id="advertising-content">Sin anuncios por ahora.</p>
    </section>
    {{> chat}}
    {{> formulario}}
  </section>
</main>
